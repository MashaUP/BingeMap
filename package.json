{
  "name": "bingemap",
  "version": "1.3.3",
  "private": true,
  "description": "BingeMap: trova le serie del catalogo che non hai ancora visto.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "check": "node scripts/check.mjs",
    "lint": "eslint .",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test": "node scripts/check.mjs && eslint . && node --test \"tests/unit/*.test.js\"",
    "build": "bash scripts/pacchetto.sh \"\" dist",
    "package": "bash scripts/pacchetto.sh && npm test && bash scripts/github-zip.sh",
    "test:e2e": "python3 -I tests/e2e/run_e2e.py",
    "e2e": "python3 -I tests/e2e/run_e2e.py",
    "pack": "npm run package"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.15.0"
  }
}
